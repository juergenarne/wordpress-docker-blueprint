###> general config data ###
APP_VER=1.2
APP_REL=2026-10-28
APP_NAME=wp
APP_COMPANY='Your Company Name'
###< general config data ###

PHP_VERSION=8.5.12

# Address the published ports bind to. 127.0.0.1 keeps them reachable
# from the host only (nginx relay), never from the internet.
BIND_ADDRESS=127.0.0.1

MARIADB_VERSION=12.3
MARIADB_LOCAL_DIR=./mariadb/data
MARIADB_DATA_DIR=/lib
MARIADB_CONF_DIR=/conf
MARIADB_ETC_DIR=/etc/mysql

MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=password
MYSQL_PORT=3306

APACHE_HTDOCS=./src/htdocs
APACHE_PORT=8080

###> wordpress ###
WORDPRESS_URL=http://localhost:8080
WORDPRESS_TABLE_PREFIX=wpy_
# Generate with ./generate-wp-keys.sh
WORDPRESS_AUTH_KEY='put your unique phrase here'
WORDPRESS_SECURE_AUTH_KEY='put your unique phrase here'
WORDPRESS_LOGGED_IN_KEY='put your unique phrase here'
WORDPRESS_NONCE_KEY='put your unique phrase here'
WORDPRESS_AUTH_SALT='put your unique phrase here'
WORDPRESS_SECURE_AUTH_SALT='put your unique phrase here'
WORDPRESS_LOGGED_IN_SALT='put your unique phrase here'
WORDPRESS_NONCE_SALT='put your unique phrase here'
###< wordpress ###

COMPOSE_BAKE=true
